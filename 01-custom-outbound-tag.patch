+        binding.spOutboundTag.onItemSelectedListener = object : AdapterView.OnItemSelectedListener {
+            override fun onItemSelected(parent: AdapterView<*>?, view: View?, position: Int, id: Long) {
+                // When the user selects "custom" (at index 3), show the custom input field
+                if (position == 3) {
+                    binding.customOutboundTagLayout.visibility = View.VISIBLE
+                } else {
+                    binding.customOutboundTagLayout.visibility = View.GONE
+                    binding.customOutboundTag.text.clear()
+                }
+            }
+
+            override fun onNothingSelected(parent: AdapterView<*>?) {
+                // This is called when the selected item disappears from the list
+            }
+        }
     }
 
     private fun bindingServer(rulesetItem: RulesetItem): Boolean {
@@ -44,8 +64,17 @@ class RoutingEditActivity : BaseActivity() {
